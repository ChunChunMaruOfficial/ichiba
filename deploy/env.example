# Copy to deploy/.env (never committed). docker-compose.yml substitutes these.

# Password of the local Postgres. It goes into a URL: letters and digits only — `openssl rand -hex 24`.
POSTGRES_PASSWORD=

# Baked into the site at build time; the same values as on Railway's «client» service.
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_YM_ID=
NEXT_PUBLIC_LEGAL_EMAIL=

# internal — Caddy's own certificate (a rehearsal, before the DNS points here).
# acme — Let's Encrypt certificates, issued by themselves once the DNS points here (the cutover).
CADDY_ISSUER=internal
