# Copy to deploy/.env.server (never committed) and fill in from Railway: service «server» → Variables → Raw Editor.
# Lines Railway adds by itself (RAILWAY_*) must NOT be copied: the server would think it still runs there.
#
# Set by docker-compose.yml, whatever this file says — no need to copy them:
#   NODE_ENV PORT DATABASE_URL REDIS_URL MEDIA_DRIVER MEDIA_DIR MODELS_DIR MEDIA_PUBLIC_URL WEB_ORIGIN APP_URL
#   REALTIME_DRIVER PUBLIC_WS_URL TELEGRAM_WEBHOOK_URL ALERTS_TELEGRAM TRUST_PROXY

# --- required ---
# The same value as on Railway: sessions, the bot's webhook secret and the IndexNow key are derived from it.
# A new one signs everybody out.
JWT_SECRET=
ADMIN_EMAILS=

# --- sign-in ---
GOOGLE_CLIENT_ID=
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# --- email (Gmail API, as on Railway) ---
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
SMTP_FROM=
SMTP_FROM_NAME=

# --- AI ---
GEMINI_API_KEY=
MISTRAL_API_KEY=
ZAI_API_KEY=
# If Google refuses requests from the hoster's address (README, «Проверка внешних сервисов»): a proxy for Gemini.
# GEMINI_BASE_URL=

# --- imported shop accounts (JSON maps of bcrypt hashes, one line each, exactly as on Railway) ---
HAND_PASSWORD_HASHES=
TG_PASSWORD_HASHES=
SHOP_PASSWORD_HASHES=

# --- backups to R2 (photos nightly from the server, the database from `db-backup`) ---
BACKUP_S3_ENDPOINT=
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
# Encrypts the nightly database dump (gpg, AES-256): `openssl rand -hex 32`. Keep a copy off the server —
# without it nobody can read the dumps.
BACKUP_PASSPHRASE=
BACKUP_MEDIA_PING_URL=
# BACKUP_DB_PING_URL=

# --- as on Railway, if set there ---
DATABASE_POOL_MAX=
CLOUDINARY_FOLDER=
AUTH_DEV_ANY_CODE=
SEED_DEMO=
# On Railway but read by no code any more (SMS sign-in was removed): SMS_PROVIDER, SMS_ALLOWED_PREFIXES,
# SMTP_PORT, SMTP_SECURE — not needed here.
