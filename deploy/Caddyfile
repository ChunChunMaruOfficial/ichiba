# The only thing open to the internet: HTTPS for ichiba.by and media.ichiba.by (deploy/README.md).
{
	servers {
		# Requests come through Cloudflare: the visitor's address is taken from its header, and only when the
		# connection really is Cloudflare's (https://www.cloudflare.com/ips/). A direct connection is its own address.
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		client_ip_headers CF-Connecting-IP X-Forwarded-For
	}
}

# ichiba.by and www are «DNS only» records in Cloudflare: visitors connect straight to this server, so the
# certificate must be a real one. CADDY_ISSUER (deploy/.env):
#   internal — Caddy's own certificate: only for a rehearsal, before the DNS points here.
#   acme     — a Let's Encrypt certificate, issued by itself once the DNS points here. Set at the cutover.

ichiba.by, www.ichiba.by {
	tls {
		issuer {$CADDY_ISSUER:internal}
	}

	# The site compresses its own pages; this covers what it passes through as is — the sitemap (half a megabyte)
	# and the API's JSON. Already-compressed answers are left alone.
	encode zstd gzip

	# The chat's WebSocket goes straight to the API: it answers on /ws only.
	@ws path /ws
	handle @ws {
		reverse_proxy server:4000 {
			header_up X-Real-IP {client_ip}
		}
	}

	# Everything else is the site; it proxies /api/* to the API itself and redirects www to the bare domain.
	handle {
		reverse_proxy client:3000 {
			# Rate limits count guests by this header: set here, so a visitor cannot send their own.
			header_up X-Real-IP {client_ip}
		}
	}
}

# Photos and videos: MEDIA_PUBLIC_URL=https://media.ichiba.by/media. Nothing else of the API is served here.
# «DNS only» in Cloudflare since 2026-11-15, like the site itself: photos are served from this server in Belarus,
# not from a CDN's nodes abroad (Указ № 60 wants the resource hosted in the country).
media.ichiba.by {
	tls {
		issuer {$CADDY_ISSUER:internal}
	}

	@media path /media/*
	handle @media {
		reverse_proxy server:4000
	}
	handle {
		respond 404
	}
}

# A second project goes here as one more block, for example:
# other.example.by {
# 	reverse_proxy other-app:8080
# }

# ---- Vivoflex (репозиторий flexoprint, свой compose-проект в /opt/vivoflex) ----
# Сайт живёт в соседнем проекте и виден Caddy по общей сети `web` под именем `vivoflex`.
vivoflex.by {
	tls {
		issuer {$CADDY_ISSUER:internal}
	}
	encode zstd gzip
	# Форма расчёта принимает макеты до 20 МБ
	request_body {
		max_size 30MB
	}
	reverse_proxy vivoflex:3000 {
		# The site's rate limit for requests reads this header: set here, so a visitor cannot send their own.
		header_up X-Real-IP {client_ip}
	}
}

# Everything else the owner holds leads to the one address, so search engines see a single site.
www.vivoflex.by, vivoflex.ru, www.vivoflex.ru, vivoflex.online, www.vivoflex.online, vivoflex.site, www.vivoflex.site, vivoflex.xyz, www.vivoflex.xyz {
	tls {
		issuer {$CADDY_ISSUER:internal}
	}
	redir https://vivoflex.by{uri} permanent
}
