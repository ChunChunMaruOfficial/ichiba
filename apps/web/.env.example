# Public address of the site: canonical links, sitemap.xml, Open Graph and robots.txt.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# The API as seen from the Next.js server (rewrites /api/* and server-side rendering for SEO).
API_URL=http://localhost:4000
# Operator details shown in the privacy policy (/privacy). Until filled, the page shows highlighted placeholders.
NEXT_PUBLIC_LEGAL_OPERATOR=
NEXT_PUBLIC_LEGAL_UNP=
NEXT_PUBLIC_LEGAL_ADDRESS=
NEXT_PUBLIC_LEGAL_EMAIL=
NEXT_PUBLIC_LEGAL_HOSTING=
