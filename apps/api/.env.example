# Server
PORT=4000
WEB_ORIGIN=http://localhost:3000
JWT_SECRET=change-me-to-a-long-random-string

# Postgres. Local dev: `npm run db` starts Prisma's local Postgres (no Docker) and prints this URL.
# Local `prisma dev` handles a single connection; raise for a real Postgres.
DATABASE_POOL_MAX=1
DATABASE_URL=postgres://postgres:postgres@localhost:51214/template1?sslmode=disable

# Photo storage: local (files in MEDIA_DIR, served at /media) or s3
MEDIA_DRIVER=local
MEDIA_DIR=storage/media
MEDIA_PUBLIC_URL=http://localhost:4000/media
# S3_ENDPOINT=
# S3_REGION=us-east-1
# S3_BUCKET=photos
# S3_ACCESS_KEY=
# S3_SECRET_KEY=

# AI ensemble (autofill, price hints, photo check, negotiation hints, NL search, moderation, chat antifraud).
# Every configured provider votes; a missing/broken key just removes that voter. No keys => rules only.
GEMINI_API_KEY=
MISTRAL_API_KEY=
ZAI_API_KEY=
# Optional model chains (best first) and limits; defaults suit free tiers.
# GEMINI_MODELS_FAST=gemini-3.5-flash-lite,gemini-3.5-flash
# GEMINI_MODELS_SMART=gemini-3.5-flash,gemini-3.5-flash-lite
# MISTRAL_MODELS_FAST=mistral-small-latest,ministral-14b-latest
# MISTRAL_MODELS_SMART=mistral-medium-latest,mistral-small-latest
# ZAI_MODELS_FAST=glm-4.7-flash,glm-4.5-flash
# ZAI_MODELS_VISION=glm-4.6v-flash
# MISTRAL_CONCURRENCY=2
# MISTRAL_MIN_INTERVAL_MS=1100
# ZAI_CONCURRENCY=2

# OAuth. Empty => the corresponding button is hidden.
GOOGLE_CLIENT_ID=
APPLE_CLIENT_ID=

# Verification codes: email goes over SMTP when SMTP_HOST is set (see the Email block below).
# Dev only: accept any 6-digit verification code (ignored when NODE_ENV=production).
AUTH_DEV_ANY_CODE=true
# SMS codes for phone sign-in. "log" prints them to the API console; "smsc" sends via SMSC.ru
# (register at smsc.ru, top up, register an alpha sender name for Belarus in the dashboard).
SMS_PROVIDER=log
SMSC_LOGIN=
SMSC_PASSWORD=
# Alpha name approved by SMSC for Belarusian operators, e.g. ichiba. Empty = the provider's default sender.
SMSC_SENDER=
# Comma-separated country prefixes SMS may go to (protection against SMS pumping fraud).
SMS_ALLOWED_PREFIXES=+375

# Email (verification codes + deal notifications). See docs/EMAIL.md.
# Empty SMTP_HOST => emails are printed to the API log. SMTP_USER is optional (local Postfix has no auth).
# Option A — external SMTP:  SMTP_HOST=mail.hosting.reg.ru  SMTP_PORT=465  SMTP_SECURE=true  SMTP_USER/SMTP_PASS
# Option B — local Postfix:  SMTP_HOST=localhost  SMTP_PORT=25  SMTP_SECURE=false  (USER/PASS empty)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
# A password with $ or ' : write it as is (no quotes) or set it as a real environment variable.
SMTP_PASS=
SMTP_FROM=noreply@your-domain.by
SMTP_FROM_NAME=ichiba
# Verify the SMTP server's TLS certificate (default: true for remote hosts, false for localhost).
# SMTP_TLS_REJECT_UNAUTHORIZED=true
# Public site address used in email links (defaults to WEB_ORIGIN).
APP_URL=http://localhost:3000

# Behind a reverse proxy (nginx) in production: number of proxy hops to trust for the client IP.
# TRUST_PROXY=1
