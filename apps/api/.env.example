# ───────────── Server ─────────────
PORT=4000
# URL(s) of the web app, comma-separated (CORS). Prod: https://<your-web>.vercel.app
WEB_ORIGIN=http://localhost:3000
# 32+ random characters: `openssl rand -base64 48`
JWT_SECRET=change-me-to-a-long-random-string

# ───────────── Database 1: PostgreSQL (Neon / Supabase / any Postgres) ─────────────
# Runtime connection. On Vercel use the POOLED url (Neon "-pooler" host, Supabase port 6543).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/ichiba?sslmode=disable
# Direct (non-pooled) url for `prisma migrate deploy`. Leave empty when DATABASE_URL is already direct.
DIRECT_URL=
# Connections per API instance. Serverless: 3–5; long-running server: 10; local `prisma dev`: 1.
DATABASE_POOL_MAX=5

# ───────────── Database 2: Redis (Upstash / Redis Cloud / any Redis) ─────────────
# Shared rate limits, WebSocket fan-out between instances, cron lock. Empty => in-process only.
# Upstash: rediss://default:<password>@<host>.upstash.io:6379
REDIS_URL=

# ───────────── Admins ─────────────
# Verified accounts with these emails become admins (/admin) on sign-in.
ADMIN_EMAILS=c4erkaoui@gmail.com

# ───────────── Photos ─────────────
# local (files in MEDIA_DIR, served at /media) — dev only; s3 — required on Vercel
# (AWS S3, Cloudflare R2, Supabase Storage, Backblaze B2, MinIO…). Bucket must be publicly readable.
MEDIA_DRIVER=local
MEDIA_DIR=storage/media
# Public base URL of the photos: http://localhost:4000/media, or the bucket / CDN url
MEDIA_PUBLIC_URL=http://localhost:4000/media
# S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_BUCKET=ichiba-photos
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_FORCE_PATH_STYLE=true
# S3_CREATE_BUCKET=false

# ───────────── Real-time (chat, notifications) ─────────────
# ws     — API serves WebSockets at /ws (long-running host / local dev)
# pusher — Pusher Channels (or Soketi / Ably in Pusher mode); the one to use on Vercel
# none   — polling fallback
# Empty => pusher if PUSHER_APP_ID is set, none on Vercel, ws elsewhere.
REALTIME_DRIVER=
# ws driver behind a proxy: public socket url, e.g. wss://api.example.com/ws
PUBLIC_WS_URL=
PUSHER_APP_ID=
PUSHER_KEY=
PUSHER_SECRET=
PUSHER_CLUSTER=eu
# Self-hosted Pusher-compatible server (Soketi): host/port for the API and, if different, for browsers
# PUSHER_HOST=
# PUSHER_PORT=
# PUSHER_PUBLIC_HOST=
# PUSHER_PUBLIC_PORT=
# PUSHER_USE_TLS=true

# ───────────── Scheduled rules (auctions, 48 h expiry, auto-complete) ─────────────
# Vercel Cron and external pingers call GET /cron/tick with "Authorization: Bearer $CRON_SECRET".
CRON_SECRET=
# Also run the rules on regular traffic, at most once a minute (default: true on Vercel).
# CRON_LAZY=true
# Long-running host without in-process timers (rules come from /cron/tick only):
# CRON_MODE=external

# ───────────── Verification codes ─────────────
# Email: resend | smtp | log (dev: code printed to the API log)
MAIL_PROVIDER=log
# Sender, e.g. "ichiba <no-reply@your-domain.com>" (Resend: a verified domain;
# Gmail SMTP: the Gmail address itself)
MAIL_FROM=
RESEND_API_KEY=
# SMTP: either a url (smtps://user:pass@smtp.gmail.com:465) or host/port/user/pass.
# Gmail: create an "app password" at myaccount.google.com/apppasswords
SMTP_URL=
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=c4erkaoui@gmail.com
# SMTP_PASS=
# Phone: twilio | log
SMS_PROVIDER=log
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
# Dev only: accept any 6-digit code (ignored when NODE_ENV=production)
AUTH_DEV_ANY_CODE=true

# ───────────── Optional integrations ─────────────
# AI listing assistant (Claude vision). Empty => manual entry only.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# OAuth. Empty => the corresponding button is hidden.
GOOGLE_CLIENT_ID=
APPLE_CLIENT_ID=

# ───────────── Demo data ─────────────
# Mock accounts and items for local development only (never runs in production).
SEED_DEMO=false
