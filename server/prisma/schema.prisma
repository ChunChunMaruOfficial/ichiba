// Data model follows Miro frame "21 DATA MODEL / ПОЛЯ ТОВАРА".

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

enum ListingStatus {
  DRAFT
  PUBLISHED
  RESERVED
  SOLD
  HIDDEN
  BLOCKED
  DELETED
}

enum Condition {
  NEW_WITH_TAGS
  LIKE_NEW
  GOOD
  VISIBLE_WEAR
}

enum SizeSystem {
  ALPHA
  SHOE_EU
  JEANS_W
  OTHER
}

/// Who the item is for. Not chosen (null) or UNISEX means it fits anyone.
enum Gender {
  MALE
  FEMALE
  UNISEX
}

enum DeliveryMethod {
  IN_PERSON
  /// No longer offered (folded into IN_PERSON); kept for earlier deals.
  PICKUP
  DELIVERY
}

enum RequestStatus {
  CREATED
  PENDING_SELLER
  ACCEPTED
  DECLINED
  COUNTER_OFFERED
  WAITING_PAYMENT
  WAITING_HANDOVER
  HANDED_OVER
  IN_TRANSIT
  RECEIVED
  COMPLETED
  CANCELLED
  DISPUTED
}

enum RequestSource {
  BUY
  OFFER
  CART
  AUCTION
}

enum SaleType {
  FIXED
  AUCTION
}

enum CodePurpose {
  VERIFY
  RESET
  LOGIN
}

model User {
  id                String    @id @default(uuid())
  username          String    @unique
  email             String?   @unique
  phone             String?   @unique
  passwordHash      String?
  emailVerifiedAt   DateTime?
  phoneVerifiedAt   DateTime?
  googleSub         String?   @unique
  appleSub          String?   @unique
  role              Role      @default(USER)
  city              String?
  bio               String?
  /// Preferred sizes from onboarding: { clothing?: string[], shoes?: string[], jeans?: string[] }
  sizes             Json?
  /// Body measurements for fit hints, cm: { height?, chest?, waist?, hips?, footLength? }
  bodyMeasurements  Json?
  /// Seller's bundle discount tiers: [{ minItems, percent }] (ascending, up to 3)
  bundleDiscounts   Json?
  /// Email preferences: { deals: boolean }
  emailPrefs        Json?
  /// Consent to personal data processing (Belarus Law No. 99-Z): when and which policy version.
  privacyAcceptedAt DateTime?
  privacyVersion    String?
  /// Account deleted by its owner: personal data wiped, the row kept for counterparties' deal history.
  deletedAt         DateTime?
  onboardedAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  listings        Listing[]
  photos          Photo[]
  favorites       Favorite[]
  following       Follow[]       @relation("follower")
  followers       Follow[]       @relation("seller")
  purchases       BuyRequest[]   @relation("buyer")
  sales           BuyRequest[]   @relation("seller")
  signals         Signal[]
  notifications   Notification[]
  offersMade      Offer[]        @relation("offerBuyer")
  offersGot       Offer[]        @relation("offerSeller")
  cartItems       CartItem[]
  threadsBuyer    Thread[]       @relation("threadBuyer")
  threadsSeller   Thread[]       @relation("threadSeller")
  messages        Message[]
  collections     Collection[]
  reports         Report[]
  bids            Bid[]
  autoBids        AutoBid[]
  reviewsWritten  Review[]       @relation("reviewAuthor")
  reviewsReceived Review[]       @relation("reviewSeller")
  videos          Video[]
  blockedAt       DateTime?
}

model VerificationCode {
  id         String      @id @default(uuid())
  /// Normalized email or E.164 phone.
  target     String
  purpose    CodePurpose
  codeHash   String
  attempts   Int         @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime    @default(now())

  @@index([target, purpose])
  /// Hourly per-address limit and daily retention cleanup.
  @@index([target, createdAt])
  @@index([createdAt])
}

model Listing {
  id                 String           @id @default(uuid())
  sellerId           String
  seller             User             @relation(fields: [sellerId], references: [id])
  status             ListingStatus    @default(DRAFT)
  title              String           @default("")
  category           String?
  subcategory        String?
  sizeSystem         SizeSystem?
  sizeValue          String?
  condition          Condition?
  price              Int?
  previousPrice      Int?
  defectsPresent     Boolean?
  defectsDescription String?
  brand              String?
  color              String?
  material           String?
  /// { shoulders, chest, waist, length, sleeve, foot_length } in cm
  measurements       Json?
  description        String?
  city               String?
  deliveryOptions    DeliveryMethod[]
  acceptsOffers      Boolean          @default(true)
  saleType           SaleType         @default(FIXED)
  /// Auction settings, applied when the listing is published (decision D16).
  auctionStep        Int?
  auctionReserve     Int?
  auctionHours       Int?
  minOfferPrice      Int?
  gender             Gender?
  styleTags          String[]
  /// { field: { value, confidence, accepted_by_user, edited_by_user } }
  aiAttributes       Json?
  aiModelVersion     String?
  blockedReason      String?
  /// Last automatic moderation verdict: { status: passed|review|unchecked, hash, reasons, checkedAt }.
  moderation         Json?
  viewsCount         Int              @default(0)
  favoritesCount     Int              @default(0)
  publishedAt        DateTime?
  /// Position in "new" feeds: publication time, moved up by a bump (frame 30 item 11).
  liftedAt           DateTime?
  lastBumpAt         DateTime?
  bumpsCount         Int              @default(0)
  /// Optional "Купить сейчас" price for an auction.
  auctionBuyNow      Int?
  /// Price new in a shop, shown as "−70% от новой".
  originalPrice      Int?
  /// Offers at or above this are accepted automatically (minOfferPrice is the auto-decline floor).
  autoAcceptPrice    Int?
  /// Draft to publish automatically at this time.
  scheduledAt        DateTime?
  /// Same item listed in several sizes: every copy shares the id of the first listing.
  groupId            String?
  /// Other sizes to list as separate copies when the draft is published.
  extraSizes         String[]         @default([])
  /// Last "скидка лайкнувшим" mailing, for the cooldown.
  likersOfferAt      DateTime?
  soldAt             DateTime?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  photos          Photo[]
  favorites       Favorite[]
  requestItems    BuyRequestItem[]
  stats           ListingStat[]
  reviews         Review[]
  signals         Signal[]
  offers          Offer[]
  cartItems       CartItem[]
  threads         Thread[]
  collectionItems CollectionItem[]
  auctions        Auction[]
  video           Video?

  @@index([status, publishedAt])
  @@index([groupId])
  @@index([status, scheduledAt])
  @@index([status, liftedAt])
  @@index([sellerId, status])
  @@index([category, status])
}

/// Where a photo's file lives. LOCAL = MEDIA_DRIVER storage (dev disk or S3), CLOUDINARY = uploaded by the browser.
enum PhotoProvider {
  LOCAL
  CLOUDINARY
}

model Photo {
  id        String        @id @default(uuid())
  ownerId   String
  owner     User          @relation(fields: [ownerId], references: [id])
  listingId String?
  listing   Listing?      @relation(fields: [listingId], references: [id], onDelete: SetNull)
  provider  PhotoProvider @default(LOCAL)
  /// LOCAL: storage key prefix, variants at `${key}_{320,640,1280}.webp`. CLOUDINARY: the asset's public_id.
  key       String
  /// CLOUDINARY: delivery URL of the stored original (secure_url), its version, format and size in bytes.
  url       String?
  version   Int?
  format    String?
  bytes     Int?
  width     Int
  height    Int
  order     Int           @default(0)
  isCover   Boolean       @default(false)
  isDefect  Boolean       @default(false)
  /// Technical quality measured at upload: { brightness, contrast, sharpness }.
  quality   Json?
  /// 64-bit difference hash (hex) of the image: near-identical photos differ in a few bits.
  dhash     String?
  /// Sent in chat: the message this photo belongs to (an album keeps `order`).
  messageId String?
  message   Message?      @relation(fields: [messageId], references: [id], onDelete: SetNull)
  createdAt DateTime      @default(now())

  @@index([listingId, order])
  @@index([messageId])
  @@index([key])
}

/// Short video of a listing (up to 30 s). The file is `${key}.${ext}`, the poster frame `${key}_{320,640}.webp`.
model Video {
  id         String        @id @default(uuid())
  ownerId    String
  owner      User          @relation(fields: [ownerId], references: [id])
  listingId  String?       @unique
  listing    Listing?      @relation(fields: [listingId], references: [id], onDelete: SetNull)
  provider   PhotoProvider @default(LOCAL)
  /// LOCAL: storage key, the file at `${key}.${ext}` and its poster at `${key}_{320,640}.webp`. CLOUDINARY: the public id.
  key        String
  ext        String
  mime       String
  width      Int
  height     Int
  durationMs Int
  /// Sent in chat: the message this video belongs to.
  messageId  String?
  message    Message?      @relation(fields: [messageId], references: [id], onDelete: SetNull)
  createdAt  DateTime      @default(now())

  @@index([ownerId])
  @@index([messageId])
}

model Favorite {
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  listingId String
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  /// feed | swipe | product
  source    String   @default("product")
  createdAt DateTime @default(now())

  @@id([userId, listingId])
  @@index([listingId])
}

model Follow {
  followerId String
  follower   User     @relation("follower", fields: [followerId], references: [id], onDelete: Cascade)
  sellerId   String
  seller     User     @relation("seller", fields: [sellerId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@id([followerId, sellerId])
  @@index([sellerId])
}

/// Recommendation signals (frame 22): view, favorite, swipe_left, request, follow…
model Signal {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  listingId String?
  listing   Listing? @relation(fields: [listingId], references: [id], onDelete: Cascade)
  type      String
  weight    Int
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

model BuyRequest {
  id              String         @id @default(uuid())
  /// Human-readable deal number shown as "№ 10482".
  number          Int            @unique @default(autoincrement())
  buyerId         String
  buyer           User           @relation("buyer", fields: [buyerId], references: [id])
  sellerId        String
  seller          User           @relation("seller", fields: [sellerId], references: [id])
  priceTotal      Int
  /// Sum of item prices before the bundle discount (null = no discount).
  subtotal        Int?
  discountPercent Int            @default(0)
  source          RequestSource  @default(BUY)
  deliveryMethod  DeliveryMethod
  deliveryPoint   String?
  contactPhone    String?
  buyerComment    String?
  trackingNumber  String?
  status          RequestStatus  @default(PENDING_SELLER)
  /// Reason for DECLINED / CANCELLED, shown to the other side.
  reason          String?
  cancelledById   String?
  expiresAt       DateTime?
  handedOverAt    DateTime?
  completedAt     DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  items   BuyRequestItem[]
  events  BuyRequestEvent[]
  offer   Offer?
  threads Thread[]
  auction Auction?
  review  Review?

  @@index([buyerId, status])
  @@index([sellerId, status])
  @@index([status, expiresAt])
}

model BuyRequestItem {
  requestId String
  request   BuyRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  listingId String
  listing   Listing    @relation(fields: [listingId], references: [id])
  price     Int

  @@id([requestId, listingId])
  @@index([listingId])
}

/// status_history from the data model.
model BuyRequestEvent {
  id        String        @id @default(uuid())
  requestId String
  request   BuyRequest    @relation(fields: [requestId], references: [id], onDelete: Cascade)
  status    RequestStatus
  byUserId  String?
  reason    String?
  at        DateTime      @default(now())

  @@index([requestId, at])
}

model Notification {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// request_new, request_accepted, request_declined, price_drop, item_reserved, item_sold…
  type      String
  payload   Json
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
}

enum OfferSide {
  BUYER
  SELLER
}

enum OfferStatus {
  PENDING
  ACCEPTED
  DECLINED
  COUNTERED
  EXPIRED
  CANCELLED
}

/// One row per negotiation round (frame 13: max 3 rounds, 48 h each).
model Offer {
  id        String      @id @default(uuid())
  listingId String
  listing   Listing     @relation(fields: [listingId], references: [id], onDelete: Cascade)
  buyerId   String
  buyer     User        @relation("offerBuyer", fields: [buyerId], references: [id])
  sellerId  String
  seller    User        @relation("offerSeller", fields: [sellerId], references: [id])
  round     Int
  amount    Int
  from      OfferSide
  status    OfferStatus @default(PENDING)
  /// Set on the accepted round: the buy request it turned into.
  requestId String?     @unique
  request   BuyRequest? @relation(fields: [requestId], references: [id])
  expiresAt DateTime
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([listingId, buyerId, createdAt])
  @@index([sellerId, status])
  @@index([buyerId, status])
  @@index([status, expiresAt])
}

model CartItem {
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  listingId String
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  addedAt   DateTime @default(now())

  @@id([userId, listingId])
}

/// One conversation per (listing, buyer); linked to the deal when there is one (frame 15).
model Thread {
  id            String      @id @default(uuid())
  listingId     String
  listing       Listing     @relation(fields: [listingId], references: [id], onDelete: Cascade)
  buyerId       String
  buyer         User        @relation("threadBuyer", fields: [buyerId], references: [id])
  sellerId      String
  seller        User        @relation("threadSeller", fields: [sellerId], references: [id])
  requestId     String?
  request       BuyRequest? @relation(fields: [requestId], references: [id])
  lastMessageAt DateTime    @default(now())
  buyerReadAt   DateTime?
  sellerReadAt  DateTime?
  createdAt     DateTime    @default(now())

  messages Message[]

  @@unique([listingId, buyerId])
  @@index([buyerId, lastMessageAt])
  @@index([sellerId, lastMessageAt])
}

enum MessageKind {
  TEXT
  LOCATION
  /// Photos and/or videos (an album), `body` is the optional caption.
  MEDIA
}

model Message {
  id        String            @id @default(uuid())
  threadId  String
  thread    Thread            @relation(fields: [threadId], references: [id], onDelete: Cascade)
  senderId  String
  sender    User              @relation(fields: [senderId], references: [id])
  /// Text, or the preview line for non-text messages ("📍 Местоположение").
  body      String
  kind      MessageKind       @default(TEXT)
  /// LOCATION: the shared point (WGS84) and, for a device fix, its accuracy in metres. Wiped on account deletion.
  lat       Float?
  lng       Float?
  accuracy  Float?
  /// Antifraud verdict: { level: warn|high, categories, source: rules|ai }.
  risk      Json?
  /// Quoted message (reply), Telegram-style.
  replyToId String?
  replyTo   Message?          @relation("messageReply", fields: [replyToId], references: [id], onDelete: SetNull)
  replies   Message[]         @relation("messageReply")
  editedAt  DateTime?
  /// Deleted for both sides. The text and media are dropped unless antifraud flagged the message (kept for moderation).
  deletedAt DateTime?
  /// Users who deleted this message only for themselves.
  hiddenFor String[]          @default([])
  photos    Photo[]
  videos    Video[]
  reactions MessageReaction[]
  pins      MessagePin[]
  createdAt DateTime          @default(now())

  @@index([threadId, createdAt])
  /// Antifraud: recent flagged messages of one sender.
  @@index([senderId, createdAt])
}

/// One reaction per user per message, as in Telegram.
model MessageReaction {
  messageId String
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId    String
  emoji     String
  createdAt DateTime @default(now())

  @@id([messageId, userId])
}

/// A pinned message: `forAll` pins show to both sides, otherwise only to `userId` who pinned it.
model MessagePin {
  messageId String
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  threadId  String
  userId    String
  forAll    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@id([messageId, userId])
  @@index([threadId])
}

/// Private collections inside favorites (frame 11).
model Collection {
  id        String           @id @default(uuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  createdAt DateTime         @default(now())
  items     CollectionItem[]

  @@index([userId])
}

model CollectionItem {
  collectionId String
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  listingId    String
  listing      Listing    @relation(fields: [listingId], references: [id], onDelete: Cascade)
  addedAt      DateTime   @default(now())

  @@id([collectionId, listingId])
}

enum ReportTarget {
  LISTING
  USER
  APPEAL
  REVIEW
}

enum ReportStatus {
  OPEN
  RESOLVED
  REJECTED
}

/// Complaints and appeals (frame 20).
model Report {
  id         String       @id @default(uuid())
  /// Null for reports raised by automatic moderation / antifraud.
  reporterId String?
  reporter   User?        @relation(fields: [reporterId], references: [id])
  /// user | ai
  source     String       @default("user")
  /// AI verdict details (votes per model, reasons, excerpts).
  details    Json?
  targetType ReportTarget
  targetId   String
  reason     String
  comment    String?
  status     ReportStatus @default(OPEN)
  resolution String?
  createdAt  DateTime     @default(now())
  resolvedAt DateTime?

  @@index([status, createdAt])
  @@index([targetType, targetId])
}

model ModerationAction {
  id          String   @id @default(uuid())
  moderatorId String
  targetType  String
  targetId    String
  action      String
  reason      String?
  at          DateTime @default(now())

  @@index([targetType, targetId])
}

enum AuctionStatus {
  ACTIVE
  /// Winner has a deal (or the item went to the runner-up).
  SOLD
  /// No bids or reserve not met: the item stays on sale at a fixed price.
  NO_SALE
  CANCELLED
}

/// Timed auction (decision D16): highest bid wins; a bid in the last minutes extends the end.
model Auction {
  id            String        @id @default(uuid())
  listingId     String
  listing       Listing       @relation(fields: [listingId], references: [id], onDelete: Cascade)
  startPrice    Int
  step          Int
  reservePrice  Int?
  startsAt      DateTime      @default(now())
  endsAt        DateTime
  status        AuctionStatus @default(ACTIVE)
  extendedTimes Int           @default(0)
  /// Current deal with the winner or, after a no-show, the runner-up.
  requestId     String?       @unique
  request       BuyRequest?   @relation(fields: [requestId], references: [id])
  createdAt     DateTime      @default(now())

  /// "Купить сейчас" price (decision D16+).
  buyNowPrice Int?

  bids     Bid[]
  autoBids AutoBid[]

  @@index([status, endsAt])
  @@index([listingId])
}

model Bid {
  id        String   @id @default(uuid())
  auctionId String
  auction   Auction  @relation(fields: [auctionId], references: [id], onDelete: Cascade)
  bidderId  String
  bidder    User     @relation(fields: [bidderId], references: [id])
  amount    Int
  /// Placed by the system on behalf of an auto-bid.
  auto      Boolean  @default(false)
  /// "Купить сейчас" purchase recorded as the final bid.
  isBuyNow  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([auctionId, amount])
  @@index([bidderId, createdAt])
}

/// One call of the AI ensemble: which models answered, how fast, and what they said (audit + cost tracking).
model AiRun {
  id          String   @id @default(uuid())
  feature     String
  subjectType String?
  subjectId   String?
  /// [{ provider, model, ok, kind?, latencyMs, inputTokens?, outputTokens? }]
  calls       Json
  /// Valid answers per provider.
  votes       Json?
  result      Json?
  latencyMs   Int
  createdAt   DateTime @default(now())

  @@index([feature, createdAt])
  @@index([subjectType, subjectId])
}

/// Proxy bid: the system bids for the user, one step at a time, up to maxAmount.
model AutoBid {
  id        String   @id @default(uuid())
  auctionId String
  auction   Auction  @relation(fields: [auctionId], references: [id], onDelete: Cascade)
  bidderId  String
  bidder    User     @relation(fields: [bidderId], references: [id])
  maxAmount Int
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([auctionId, bidderId])
  @@index([auctionId, active])
}

/// Buyer's review of the seller after a completed deal (frame 30, V2 → MVP).
model Review {
  id        String     @id @default(uuid())
  requestId String     @unique
  request   BuyRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  listingId String?
  listing   Listing?   @relation(fields: [listingId], references: [id], onDelete: SetNull)
  authorId  String
  author    User       @relation("reviewAuthor", fields: [authorId], references: [id])
  sellerId  String
  seller    User       @relation("reviewSeller", fields: [sellerId], references: [id])
  rating    Int
  /// as_described | fast | polite | packaging | bad_description | late | rude
  tags      String[]
  text      String?
  reply     String?
  repliedAt DateTime?
  /// Hidden by a moderator.
  hidden    Boolean    @default(false)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([sellerId, createdAt])
}

/// Daily per-listing counters for seller statistics.
model ListingStat {
  listingId String
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  day       DateTime @db.Date
  views     Int      @default(0)
  favorites Int      @default(0)
  carts     Int      @default(0)
  chats     Int      @default(0)
  offers    Int      @default(0)
  requests  Int      @default(0)

  @@id([listingId, day])
  @@index([day])
}

/// Outgoing email queue: retried with backoff so a flaky SMTP never loses a deal notification.
model EmailOutbox {
  id        String    @id @default(uuid())
  to        String
  subject   String
  html      String
  text      String
  /// e.g. request_new; used for List-Unsubscribe and analytics.
  kind      String
  userId    String?
  status    String    @default("PENDING")
  attempts  Int       @default(0)
  lastError String?
  sendAfter DateTime  @default(now())
  sentAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([status, sendAfter])
}
