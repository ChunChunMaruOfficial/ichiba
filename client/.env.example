# Public address of the site: canonical links, sitemap.xml, Open Graph and robots.txt.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# The API as seen from the Next.js server (rewrites /api/* and server-side rendering for SEO).
API_URL=http://localhost:4000
# Operator details for the privacy policy (/privacy): ИП/organisation name, УНП, legal address, contact email.
# Belarusian law (99-З) requires the operator to be named; unset requisites are simply left out of the text.
NEXT_PUBLIC_LEGAL_OPERATOR=
NEXT_PUBLIC_LEGAL_UNP=
NEXT_PUBLIC_LEGAL_ADDRESS=
NEXT_PUBLIC_LEGAL_EMAIL=c4erkaoui@gmail.com
